{
  "name": "chronos-search-agent",
  "version": "1.0.0",
  "description": "High-speed chat agent with parallel web search, deep page extraction, and bi-temporal episodic memory.",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "node --import tsx --watch-path=src/server --watch-path=src/shared src/server/index.ts",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.52.0",
    "@google/genai": "^1.0.0",
    "@mozilla/readability": "^0.6.0",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "linkedom": "^0.18.9",
    "lucide-react": "^0.511.0",
    "openai": "^4.104.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.2",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
