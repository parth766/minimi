# ==============================================================================
# Chronos Search Agent - Environment Configuration
# Copy this file to .env and fill in your API key(s) or local Ollama settings.
# ==============================================================================

# ── 1. LLM Provider (configure at least ONE) ───────────────────────────────────
# Auto-detect priority: OpenAI -> Anthropic -> Gemini -> Ollama,
# or pin explicitly via LLM_PROVIDER.

OPENAI_API_KEY=
# Optional: use any OpenAI-compatible endpoint (OpenRouter, Groq, Together, etc.)
# OPENAI_BASE_URL=

# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Local Ollama (no API key required — run `ollama serve` and pull a tool-capable model)
# OLLAMA_MODEL=qwen3:8b          # e.g. llama3.1, qwen2.5:7b, qwen3:8b, mistral-nemo
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_NUM_CTX=16384

# Optional model overrides
# LLM_PROVIDER=openai            # openai | anthropic | gemini | ollama
# LLM_MODEL=                     # e.g. gpt-4.1, claude-sonnet-4-6, gemini-2.5-flash, qwen3:8b
# DISTILL_MODEL=                 # lightweight model for async episodic claim distillation

# ── 2. Web Search Provider (strongly recommended for best accuracy & speed) ────
# Auto-detect priority: Tavily -> Exa -> Serper -> Brave -> built-in DuckDuckGo fallback.
# Leaving all search keys blank activates the zero-key DuckDuckGo + Readability fallback.

TAVILY_API_KEY=
# EXA_API_KEY=
# SERPER_API_KEY=
# BRAVE_SEARCH_API_KEY=

# ── 3. Server & Storage ────────────────────────────────────────────────────────
# PORT=3000
# DB_PATH=./data/agent.db
